---
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
const links = [
  { label: "Documentation", href: "/getting-started/" },
  { label: "Architecture", href: "/architecture/" },
  { label: "API", href: "/api/" },
  { label: "MCP", href: "/mcp/" },
  { label: "Nix", href: "/nix/" },
];
---

<header
  class="site-header fixed inset-x-0 top-0 z-50 border-b"
  data-site-header
>
  <div
    class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-5 sm:px-8 lg:px-10"
  >
    <div class="flex items-center gap-8">
      <Logo />
      <nav
        class="hidden items-center gap-1 lg:flex"
        aria-label="Primary navigation"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={path === link.href ? "page" : undefined}
              class:list={[
                "focus-ring rounded-md px-3 py-2 text-[13px] font-medium transition-colors",
                path === link.href
                  ? "text-foreground"
                  : "text-foreground/70 hover:text-foreground",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-2">
      <button
        id="search-open"
        class="border-border bg-background/60 text-muted-foreground hover:text-foreground hidden h-10 items-center gap-2 border px-3 text-xs transition-colors md:flex"
        type="button"
        aria-label="Search documentation"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
          ></path></svg
        >
        Search <kbd class="ml-4 text-[10px]">⌘K</kbd>
      </button>
      <button
        id="theme-toggle"
        class="text-muted-foreground hover:bg-muted hover:text-foreground grid h-10 w-10 place-items-center transition-colors"
        type="button"
        aria-label="Toggle color theme"
      >
        <svg
          class="h-4 w-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
          ><path d="M12 3a9 9 0 1 0 9 9c0-.3 0-.6-.1-.9A7 7 0 0 1 12.9 3H12Z"
          ></path></svg
        >
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path></svg
        >
      </button>
      <a
        href="https://github.com/Fractal-Tess/scorch"
        class="cut-corners-sm border-border hover:bg-muted hidden h-10 items-center border px-5 text-sm font-medium transition-colors sm:inline-flex"
        >GitHub</a
      >
      <a
        href="/getting-started/"
        class="cut-corners-sm bg-foreground text-background hover:bg-foreground/85 hidden h-10 items-center px-5 text-sm font-medium transition-colors sm:inline-flex"
        >Get started</a
      >
      <button
        id="mobile-toggle"
        type="button"
        class="text-muted-foreground hover:bg-muted grid h-10 w-10 place-items-center lg:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="border-border bg-background hidden border-t px-5 py-4 lg:hidden"
    aria-label="Mobile navigation"
  >
    <div class="mx-auto grid max-w-[1440px] gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hover:bg-muted rounded px-3 py-2.5 text-sm font-medium"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/configuration/"
        class="hover:bg-muted rounded px-3 py-2.5 text-sm font-medium"
        >Configuration</a
      >
      <a
        href="/cli/"
        class="hover:bg-muted rounded px-3 py-2.5 text-sm font-medium"
        >CLI reference</a
      >
      <a
        href="/skill/"
        class="hover:bg-muted rounded px-3 py-2.5 text-sm font-medium"
        >Agent Skill</a
      >
      <a
        href="https://github.com/Fractal-Tess/scorch"
        class="border-border mt-2 rounded border px-3 py-2.5 text-sm font-medium"
        >GitHub</a
      >
    </div>
  </nav>
</header>

<dialog
  id="search-dialog"
  class="border-border bg-background text-foreground m-auto w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-md border p-0 shadow-2xl backdrop:bg-black/35 backdrop:backdrop-blur-sm"
>
  <form
    method="dialog"
    class="border-border flex items-center gap-3 border-b px-4"
  >
    <svg
      viewBox="0 0 24 24"
      class="text-muted-foreground h-4 w-4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
      ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"
      ></path></svg
    >
    <input
      id="search-input"
      type="search"
      placeholder="Search Scorch docs…"
      class="placeholder:text-muted-foreground h-13 min-w-0 flex-1 bg-transparent text-sm outline-none"
      autocomplete="off"
    />
    <button
      value="cancel"
      class="border-border text-muted-foreground rounded border px-1.5 py-1 text-[10px]"
      >ESC</button
    >
  </form>
  <div id="search-results" class="max-h-[360px] overflow-y-auto p-2"></div>
  <p
    id="search-empty"
    class="text-muted-foreground hidden px-4 py-10 text-center text-sm"
  >
    No matching documentation.
  </p>
</dialog>
