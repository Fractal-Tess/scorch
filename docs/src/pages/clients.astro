---
import DocLayout from "../layouts/DocLayout.astro";
const headings = [
  { label: "Python", href: "#python" },
  { label: "JavaScript", href: "#javascript" },
  { label: "Operations", href: "#operations" },
  { label: "Gateways and errors", href: "#gateways-errors" },
