import DocLayout from "../layouts/DocLayout.astro";
const headings = [
  { label: "Precedence", href: "#precedence" },
  { label: "Server variables", href: "#server-variables" },
  { label: "Client variables", href: "#client-variables" },
  { label: "Obscura renderer", href: "#browser-policy" },
  { label: "Search engines", href: "#search-engines" },
  { label: "Logging", href: "#logging" },
  { label: "Deployment recipes", href: "#deployment-recipes" },
