import DocLayout from "../layouts/DocLayout.astro";
const headings = [
  { label: "Process boundary", href: "#process-boundary" },
  { label: "Scrape pipeline", href: "#scrape-pipeline" },
  { label: "Browser rendering", href: "#browser-rendering" },
  { label: "Metasearch", href: "#metasearch" },
